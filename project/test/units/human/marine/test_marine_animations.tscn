[sub_resource type="GDScript" id="GDScript_c7ssw"]
script/source = "extends Node3D

@onready var animation_tree: MarineAnimation = $HumanMarineUnit/MarineAnimation
@export var unit: HumanMarineUnit

enum State
{
	IDLE,
	RUNNING,
	DEAD,
	SHOOTING
}

@export
var animation_state:State:
	set(value):
		animation_state = value
		_refresh_state()

func _refresh_state() -> void:
	if not unit:
		return
	
	match animation_state:
		State.IDLE:
			unit.velocity = Vector3.ZERO
			unit._get_health_stat().health = 100
			unit._is_shooting = false
		State.SHOOTING:
			unit.velocity = Vector3.ZERO
			unit._get_health_stat().health = 100
			unit._is_shooting = true
		State.RUNNING:
			unit.velocity = Vector3.FORWARD * 10
			unit._get_health_stat().health = 100
		State.DEAD:
			unit._get_health_stat().health = 0
			
func _ready() -> void:
	_refresh_state()
"

