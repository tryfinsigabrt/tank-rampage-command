[sub_resource type="GDScript" id="GDScript_c7ssw"]
script/source = "@tool
extends Node3D

@onready var animation_tree: MarineAnimation = $HumanMarineUnit/MarineAnimation


@export
var animation_state:MarineAnimation.State:
	set(value):
		animation_state = value
		if animation_tree:
			animation_tree.state = value


func _ready() -> void:
	animation_tree.state = animation_state
"

