3d_physics/layer_2="terrain"
3d_physics/layer_3="unit"
3d_physics/layer_4="world_dynamic"
3d_physics/layer_5="world_boundaries"
3d_physics/layer_6="building"
3d_physics/layer_7="structure_infantry"
3d_physics/layer_8="resource"
3d_physics/layer_9="infantry"
