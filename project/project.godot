; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="tank-rampage-command"
config/version="0.0.0"
run/main_scene="uid://c15qtg2d1emrk"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SignalBus="*res://core/signal_bus.gd"
Collisions="*res://utils/collisions.gd"
BeehaveGlobalMetrics="*uid://c3ktl6ontsdt7"
BeehaveGlobalDebugger="*uid://bl3ma400hpvsh"
DebugMenu="*uid://cggqb75a8w8r"
GameManager="*uid://3t5i7ypkifpd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/missing_await=1

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[editor_plugins]

enabled=PackedStringArray("res://addons/beehave/plugin.cfg", "res://addons/debug_menu/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/utility_ai/plugin.cfg")

[global_group]

Unit="A game unit"
UnitActions="AI actions for a unit"
UnitClassTank="Tank Unit Class"
Damageable="A node that can receive damage events"
Match="Top level node for controlling game state - when a team wins, loses"
MatchTeam="A team in the match"
Player="Node that gives player control over the battlefield. Usually a PlayerUnitActions scene"
WorldBoundaries="Marks edge of the world. Used to keep AI fenced into the map"
Interactable="A Node3D that can be interacted with by the player, such as a Unit, Resource, or Structure"
FogOfWar="The fog of war node in the scene"
UnitClassSoldier="Marine Unit Class"
UnitClassArtillery="Artillery Unit Class"
Structure="A non-unit asset such as defensive structures like turrets, spikes, walls"
Building="A team asset that can build other things or gather resources like a command center or barracks"
GameResource="A resource in the game such as scrap"
TeamAsset="A unit, building, or structure assigned to a team"
ControlPoint="Control Point to capture on map that increases personnel cap"
UI="in-game UI like health bars and building indicators"
HUD=""
TeamVisible="Only visible to the current player team"

